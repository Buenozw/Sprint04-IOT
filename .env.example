# Copie para .env e preencha. Nada aqui e obrigatorio para rodar a demo.
# NUNCA suba o arquivo .env para o GitHub (ele ja esta no .gitignore).

# ---------------- IA generativa ----------------
# auto = usa o Gemini se GEMINI_API_KEY estiver preenchida; sem chave, modo offline.
# Outras opcoes: gemini | ollama | anthropic | openai_compat | offline
PETLINK_LLM_PROVIDER=auto

# Opcao 1 (gratuita): Google Gemini - chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcao 2 (gratuita, local): Ollama - instale o Ollama, rode `ollama pull llama3.2`
# e troque a primeira linha para PETLINK_LLM_PROVIDER=ollama (nao precisa de chave)

# Opcao 3 (paga): Claude
ANTHROPIC_API_KEY=

# Deixe vazio para usar o modelo padrao do provedor
# (gemini-flash-latest, llama3.2 ou claude-haiku-5-5)
PETLINK_LLM_MODEL=

# ---------------- Banco ----------------
PETLINK_DB=petlink.db
PETLINK_SEED=1

# ---------------- Ponte MQTT (HiveMQ Cloud: porta 8883 e MQTT_TLS=1) ----------------
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_TLS=0
MQTT_USER=
MQTT_PASS=
MQTT_TOPICO=petlink/+/telemetria
API_URL=http://localhost:8000
AGREGACAO_S=0
