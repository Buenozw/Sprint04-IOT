# Copie para .env e preencha. Nada aqui e obrigatorio para rodar a demo.

# IA generativa (Claude). Sem chave, o assistente usa o modo offline (templates).
ANTHROPIC_API_KEY=
PETLINK_LLM_MODEL=claude-haiku-5-5

# Banco SQLite e seed automatico de 7 dias de historico
PETLINK_DB=petlink.db
PETLINK_SEED=1

# Ponte MQTT (HiveMQ Cloud: porta 8883 e MQTT_TLS=1)
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_TLS=0
MQTT_USER=
MQTT_PASS=
MQTT_TOPICO=petlink/+/telemetria
API_URL=http://localhost:8000
AGREGACAO_S=0
